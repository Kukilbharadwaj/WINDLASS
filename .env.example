# Copy to .env and fill in what you need. Windlass loads .env automatically.
#
# Nothing here is required — the core install runs offline with the built-in
# fake model, hashed embeddings and in-memory vector store.

# --- Model providers -------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://my-gateway/v1     # any OpenAI-compatible endpoint
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=...
# OLLAMA_BASE_URL=http://localhost:11434
# HUGGINGFACE_API_KEY=hf_...        # or HF_TOKEN — hosted BGE/E5 embeddings

# --- Vector stores ---------------------------------------------------------
# PINECONE_API_KEY=...

# --- Observability ---------------------------------------------------------
# LANGSMITH_API_KEY=...
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=https://cloud.langfuse.com     # US region: https://us.cloud.langfuse.com
#                                              # LANGFUSE_BASE_URL is accepted too

# --- Framework defaults ----------------------------------------------------
# WINDLASS_DEFAULT_LLM=openai
# WINDLASS_DEFAULT_EMBEDDING=huggingface
# WINDLASS_DEFAULT_VECTORDB=faiss
# WINDLASS_TEMPERATURE=0.0
# WINDLASS_MAX_CONCURRENCY=16
# WINDLASS_REQUEST_TIMEOUT=60

# Nested settings use a double underscore.
# WINDLASS_RETRY__ATTEMPTS=4
# WINDLASS_CACHE__ENABLED=true
# WINDLASS_CACHE__BACKEND=disk

# Set to DEBUG to see what the framework is doing.
# WINDLASS_LOG_LEVEL=INFO
